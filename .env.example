# SQLite is the default. For PostgreSQL set both variables and URL-encode the
# password in LOGENTRA_DATABASE_URL.
# LOGENTRA_POSTGRES_PASSWORD=
# LOGENTRA_DATABASE_URL=postgresql+psycopg://logentra:CHANGE_ME@postgres:5432/logentra
# LOGENTRA_CORS_ORIGINS=https://engineering.example.com
# Production TLS overlay only. Directory contains fullchain.pem and privkey.pem.
# LOGENTRA_TLS_DIRECTORY=/absolute/path/to/tls
# LOGENTRA_TLS_BIND=127.0.0.1
# LOGENTRA_TLS_PORT=8443
# Optional PostgreSQL performance tuning (production overlay defaults shown).
# LOGENTRA_WORKERS=2
# LOGENTRA_DB_POOL_SIZE=20
# LOGENTRA_DB_MAX_OVERFLOW=20
# LOGENTRA_DB_POOL_TIMEOUT=30
# LOGENTRA_THREADPOOL_SIZE=64
